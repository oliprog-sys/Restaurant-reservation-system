generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  CUSTOMER
  SUPER_ADMIN
}

enum StaffRole {
  RECEPTIONIST
  RESTAURANT_ADMIN
}

enum TableStatus {
  AVAILABLE
  MAINTENANCE
  DISABLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id              String               @id @default(uuid())

  name            String
  email           String               @unique
  password        String

  phoneNumber     String?

  globalRole      GlobalRole           @default(CUSTOMER)

  reservations    Reservation[]
  staffRoles      RestaurantStaff[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([email])
}

model Restaurant {
  id              String               @id @default(uuid())

  name            String
  description     String?

  address         String
  city            String

  phone           String
  email           String?

  openingTime     String
  closingTime     String

  isActive        Boolean              @default(true)

  tables          Table[]
  reservations    Reservation[]
  staff           RestaurantStaff[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([city])
  @@index([name])
}

model RestaurantStaff {
  id              String               @id @default(uuid())

  userId          String
  restaurantId    String

  role            StaffRole

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt       DateTime             @default(now())

  @@unique([userId, restaurantId])

  @@index([restaurantId])
  @@index([userId])
}

model Table {
  id              String               @id @default(uuid())

  restaurantId    String

  tableNumber     Int

  capacity        Int

  status          TableStatus          @default(AVAILABLE)

  isActive        Boolean              @default(true)

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  reservations    Reservation[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([restaurantId, tableNumber])

  @@index([restaurantId])
  @@index([status])
}

model Reservation {
  id                  String                @id @default(uuid())

  userId              String
  restaurantId        String
  tableId             String

  reservationStart    DateTime
  reservationEnd      DateTime

  guestCount          Int

  specialRequest      String?

  status              ReservationStatus    @default(PENDING)

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurant          Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  table               Table                 @relation(fields: [tableId], references: [id], onDelete: Cascade)

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([restaurantId])

  @@index([tableId])

  @@index([userId])

  @@index([status])

  @@index([reservationStart])

  @@index([reservationEnd])

  @@index([reservationStart, reservationEnd])
}